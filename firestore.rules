rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (UID)
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (required)
    //   - role: string (customer, seller, admin)
    //   ... other profile fields
    //
    // Collection: sellerApplications
    // Document ID: applicationId (usually UID)
    // Fields:
    //   - uid: string (required)
    //   - shopName: string (required)
    //   - category: string (required)
    //   - address: string (required)
    //   - phone: string (required)
    //   - status: string (pending, approved, rejected)
    //   - appliedAt: string
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == "Shubhamyadav53362@gmail.com");
    }

    function isValidUser(data) {
      return data.uid is string && 
             data.displayName is string && data.displayName.size() < 100;
    }

    function isValidApplication(data) {
      return data.uid is string &&
             data.shopName is string && data.shopName.size() < 100 &&
             data.category is string &&
             data.address is string && data.address.size() < 500 &&
             data.phone is string && data.phone.size() == 10 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /sellerApplications/{applicationId} {
      allow read: if isOwner(applicationId) || isAdmin();
      allow create: if isOwner(applicationId) && isValidApplication(request.resource.data) && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
